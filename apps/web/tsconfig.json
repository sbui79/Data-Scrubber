{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "dom.iterable", "ES2022"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "preserve", "strict": true, "noEmit": true,
    "skipLibCheck": true, "incremental": true, "allowJs": false, "resolveJsonModule": true,
    "isolatedModules": true, "esModuleInterop": true,
    "plugins": [{ "name": "next" }], "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
