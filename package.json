{
  "name": "privatepath",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "seed": "tsx --env-file=.env scripts/seed.mts",
    "e2e": "playwright test",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@privatepath/config": "workspace:*",
    "@privatepath/core": "workspace:*",
    "@privatepath/crypto": "workspace:*",
    "@privatepath/db": "workspace:*",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7"
  }
}