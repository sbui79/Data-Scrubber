{
  "name": "privatepath",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit false || tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "seed": "tsx --env-file=.env scripts/seed.mts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "tsx": "^4.19.0",
    "@privatepath/config": "workspace:*",
    "@privatepath/core": "workspace:*",
    "@privatepath/crypto": "workspace:*",
    "@privatepath/db": "workspace:*"
  }
}