generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SUPPORT
  COMPLIANCE_ADMIN
  SYSTEM_ADMIN
}

enum SourceStatus {
  PENDING_REVIEW
  AVAILABLE
  UNAVAILABLE
  MANUAL_ONLY
}

enum ListingStatus {
  FOUND
  NOT_FOUND
  NOT_SURE
}

enum RequestType {
  OPT_OUT
  DELETION
  CORRECTION
  SUPPRESSION
  FOLLOW_UP
}

enum RequestStatus {
  NOT_STARTED
  LISTING_NOT_FOUND
  LISTING_FOUND
  DRAFT_READY
  AWAITING_USER_ACTION
  SUBMITTED_BY_USER
  VERIFICATION_REQUESTED
  IN_PROGRESS
  COMPLETED
  DENIED_UNAVAILABLE
  FOLLOW_UP_DUE
  ARCHIVED
}

model User {
  id                           String   @id @default(cuid())
  email                        String   @unique
  displayName                  String
  authProviderId               String   @unique
  role                         Role     @default(USER)
  marketingConsentAt           DateTime?
  termsVersionAccepted         String?
  privacyPolicyVersionAccepted String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  deletedAt                    DateTime?

  key            UserKey?
  profile        UserProfile?
  consents       ConsentRecord[]
  listingReviews ListingReview[]
  requests       RemovalRequest[]
  reminders      Reminder[]
  notifications  Notification[]
  evidence       EvidenceFile[]
  supportCases   SupportCase[]
  californiaProgress CaliforniaProgress?
  subscriptions  Subscription[]
}

/// Per-user data key, wrapped by the KMS master key. Deleting this row crypto-shreds the user's ciphertext.
model UserKey {
  userId     String   @id
  wrappedDek Bytes
  kmsKeyId   String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// All encrypted* columns hold version||nonce||ciphertext||tag (AES-256-GCM, AAD = table/column/rowId).
model UserProfile {
  id                          String   @id @default(cuid())
  userId                      String   @unique
  encryptedLegalFirstName     Bytes
  encryptedLegalLastName      Bytes
  encryptedAliases            Bytes?
  encryptedBirthYearOrAgeRange Bytes?
  encryptedCurrentCity        Bytes?
  encryptedCurrentState       Bytes?
  encryptedPreviousLocations  Bytes?
  encryptedEmailAddresses     Bytes?
  encryptedPhoneNumbers       Bytes?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConsentRecord {
  id              String    @id @default(cuid())
  userId          String
  consentType     String
  policyVersion   String
  grantedAt       DateTime  @default(now())
  revokedAt       DateTime?
  ipAddressHashed String?
  userAgentHashed String?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Source {
  id                   String       @id @default(cuid())
  name                 String
  domain               String       @unique
  category             String
  officialOptOutUrl    String
  instructionsMarkdown String
  verificationMethod   String
  difficulty           Int
  sourceStatus         SourceStatus @default(PENDING_REVIEW)
  isDemo               Boolean      @default(true)
  lastReviewedAt       DateTime?
  publishedAt          DateTime?
  version              Int          @default(1)
  createdByAdminId     String
  /// DB CHECK (approvedByAdminId <> createdByAdminId) added in the migration SQL (four-eyes rule).
  approvedByAdminId    String?

  versions       SourceVersion[]
  listingReviews ListingReview[]
  requests       RemovalRequest[]
}

model SourceVersion {
  id               String   @id @default(cuid())
  sourceId         String
  version          Int
  snapshot         Json
  createdByAdminId String
  approvedByAdminId String?
  createdAt        DateTime @default(now())
  source           Source   @relation(fields: [sourceId], references: [id])

  @@unique([sourceId, version])
}

model ListingReview {
  id                        String        @id @default(cuid())
  userId                    String
  sourceId                  String
  status                    ListingStatus
  encryptedListingUrl       Bytes?
  userConfirmedOwnershipAt  DateTime?
  notesEncrypted            Bytes?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  user                      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  source                    Source        @relation(fields: [sourceId], references: [id])

  @@unique([userId, sourceId])
}

model RemovalRequest {
  id                             String        @id @default(cuid())
  userId                         String
  sourceId                       String
  listingReviewId                String?
  requestType                    RequestType
  status                         RequestStatus @default(NOT_STARTED)
  encryptedListingUrl            Bytes?
  encryptedDraftContent          Bytes?
  userApprovedAt                 DateTime?
  userSubmittedAt                DateTime?
  expectedResponseAt             DateTime?
  followUpAt                     DateTime?
  completedAt                    DateTime?
  encryptedConfirmationReference Bytes?
  encryptedNotes                 Bytes?
  createdAt                      DateTime      @default(now())
  updatedAt                      DateTime      @updatedAt

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    Source                 @relation(fields: [sourceId], references: [id])
  history   RequestStatusHistory[]
  evidence  EvidenceFile[]
  reminders Reminder[]

  @@index([userId, status])
}

model RequestStatusHistory {
  id         String         @id @default(cuid())
  requestId  String
  fromStatus RequestStatus?
  toStatus   RequestStatus
  createdAt  DateTime       @default(now())
  request    RemovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model EvidenceFile {
  id                        String         @id @default(cuid())
  userId                    String
  removalRequestId          String
  encryptedStorageKey       Bytes
  originalFilenameEncrypted Bytes
  contentType               String
  sizeBytes                 Int
  uploadedAt                DateTime       @default(now())
  deletedAt                 DateTime?
  user                      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  request                   RemovalRequest @relation(fields: [removalRequestId], references: [id], onDelete: Cascade)
}

model Reminder {
  id               String          @id @default(cuid())
  userId           String
  removalRequestId String?
  /// FOLLOWUP_7|14|30|60|90 | RECHECK_6M|RECHECK_12M | CUSTOM | CALIFORNIA_DROP
  type             String
  scheduledFor     DateTime
  /// SCHEDULED | SENT | MUTED | CANCELLED
  status           String          @default("SCHEDULED")
  /// IN_APP | EMAIL
  channel          String
  createdAt        DateTime        @default(now())
  sentAt           DateTime?
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  request          RemovalRequest? @relation(fields: [removalRequestId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Append-only: UPDATE/DELETE blocked by a trigger in the migration SQL. Rows are hash-chained.
/// Deliberately has no foreign keys so account deletion can anonymize actor/target ids.
model AuditEvent {
  id                   String   @id @default(cuid())
  /// Chain order. Inserts are serialized by an advisory lock, so seq order == chain order.
  seq                  BigInt   @unique @default(autoincrement())
  actorUserId          String?
  targetUserId         String?
  eventType            String
  entityType           String
  entityId             String?
  metadataRedactedJson Json
  prevHash             String?
  hash                 String
  createdAt            DateTime @default(now())
  ipAddressHashed      String?
  userAgentHashed      String?

  @@index([targetUserId, createdAt])
  @@index([eventType, createdAt])
}

model SupportCase {
  id               String   @id @default(cuid())
  userId           String
  status           String
  category         String
  subject          String
  messageEncrypted Bytes
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminAccessGrant {
  id                String    @id @default(cuid())
  adminUserId       String
  targetUserId      String
  supportCaseId     String
  purpose           String
  approvedByAdminId String
  grantedAt         DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
}

/// Which steps of the (external, user-completed) California DROP checklist the user has ticked off.
model CaliforniaProgress {
  userId         String   @id
  completedSteps Int[]
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// MOCK billing only for now (no payment provider). Plans never gate export, deletion or safety features.
model Subscription {
  id            String    @id @default(cuid())
  userId        String
  /// CLEANUP_ONE_TIME | MONITORING_MONTHLY
  plan          String
  /// ACTIVE | CANCELLED
  status        String
  mockReference String?
  startedAt     DateTime  @default(now())
  cancelledAt   DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
