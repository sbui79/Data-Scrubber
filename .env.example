# No secrets here. Copy to .env and fill in locally.
NODE_ENV=development
DATABASE_URL=postgresql://privatepath:privatepath@localhost:5432/privatepath
# Local dev only: openssl rand -base64 32
MOCK_KMS_MASTER_KEY=
# Any random string >= 16 chars, used to HMAC IP/user-agent values
HASH_PEPPER=
# 32+ random chars; enables POST /api/v1/internal/process-reminders (call it from your scheduler)
CRON_SECRET=
APP_URL=http://localhost:3000
CLERK_SECRET_KEY=
AUTH_MODE=mock
FEATURE_MFA=false
FEATURE_FAMILY_MANAGER=false
FEATURE_EMAIL_SENDING=false
